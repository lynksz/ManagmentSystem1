@model Proposal
@{ ViewData["Title"] = "Видалення пропозиції"; }

<h2>Видалити пропозицію?</h2>
<dl class="row">
    <dt class="col-sm-2">Викладач</dt><dd class="col-sm-10">@(Model.Teacher?.Name ?? "—")</dd>
    <dt class="col-sm-2">Курс</dt><dd class="col-sm-10">@Model.CourseName</dd>
    <dt class="col-sm-2">Тип</dt><dd class="col-sm-10">@Model.ProposalType</dd>
    <dt class="col-sm-2">Статус</dt><dd class="col-sm-10">@Model.Status</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Так, видалити</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>
