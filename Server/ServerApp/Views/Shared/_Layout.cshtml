<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Адмін-панель</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark px-3">
        <a class="navbar-brand" asp-controller="Teachers" asp-action="Index">Адмін-панель</a>
        <ul class="navbar-nav me-auto">
            <li class="nav-item"><a class="nav-link" asp-controller="Teachers" asp-action="Index">Викладачі</a></li>
            <li class="nav-item"><a class="nav-link" asp-controller="Courses" asp-action="Index">Курси</a></li>
            <li class="nav-item"><a class="nav-link" asp-controller="Proposals" asp-action="Index">Пропозиції</a></li>
        </ul>
        <a class="btn btn-outline-light btn-sm" href="/auth/logout">Вийти</a>
    </nav>

    <div class="container mt-4">
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
